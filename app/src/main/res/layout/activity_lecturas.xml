<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lecturas de Temperatura"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Formulario para ingresar datos -->
        <EditText
            android:id="@+id/etNombreBodega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la Bodega (ej: Bodega A)"
            android:inputType="text"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etTemperatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Temperatura (°C) ej: 4.5"
            android:inputType="numberDecimal|numberSigned"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Botón Guardar -->
        <Button
            android:id="@+id/btnGuardarLectura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar Lectura"
            android:backgroundTint="#7C3AED"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Encabezado del Historial -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Historial de Registros"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:layout_marginBottom="8dp" />

        <!-- Texto para desplegar las lecturas obtenidas de Firestore -->
        <TextView
            android:id="@+id/txtHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando lecturas..."
            android:textSize="14sp"
            android:textColor="#4B5563"
            android:background="#FFFFFF"
            android:padding="16dp" />

    </LinearLayout>
</ScrollView>